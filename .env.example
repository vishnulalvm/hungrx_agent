# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Host here is the Docker Compose service name ("postgres"), reachable from
# other containers on the hungrx_network bridge network. Running the api/
# worker directly on the host (outside Docker) instead? Point this at
# localhost — docker-compose.override.yml publishes 5432 to the host in dev.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hungrx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hungrx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# API (FastAPI)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin Dashboard (Next.js)
# ---------------------------------------------------------------------------
# Server-only: where the dashboard's own backend (Route Handlers) reaches
# FastAPI. Defaults to the docker-compose service name/port already, so this
# only needs to change for a non-Docker deployment.
API_INTERNAL_BASE_URL=http://api:8000

# ---------------------------------------------------------------------------
# LangGraph / LLM
# ---------------------------------------------------------------------------
# Required for the AI extraction step (turning a crawled page into
# structured menu/nutrition data) to work. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06

# ---------------------------------------------------------------------------
# First admin login (used once, by `docker compose exec api uv run python -m database.seed`)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@hungrx.local
SEED_SUPER_ADMIN_PASSWORD=change-me-immediately

# ---------------------------------------------------------------------------
# Playwright / Crawler
# ---------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
CRAWLER_USER_AGENT=hungrx-crawler/1.0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
