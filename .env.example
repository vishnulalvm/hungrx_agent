# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Host here is the Docker Compose service name ("postgres"), reachable from
# other containers on the hungrx_network bridge network. Running the api/
# worker directly on the host (outside Docker) instead? Point this at
# localhost — docker-compose.override.yml publishes 5432 to the host in dev.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hungrx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hungrx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# API (FastAPI)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin Dashboard (Next.js)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are baked in at build time and read by the browser,
# so this must stay a host-reachable URL, not the internal "api" service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# LangGraph / LLM
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LANGGRAPH_CHECKPOINT_URL=

# ---------------------------------------------------------------------------
# Playwright / Crawler
# ---------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
CRAWLER_USER_AGENT=hungrx-crawler/1.0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
