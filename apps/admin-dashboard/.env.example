# Server-only: where this app's Route Handlers (login/logout/refresh, and
# the generic /api/proxy/[...path]) reach FastAPI. Defaults to the
# docker-compose service name/port; override for other deployments. The
# browser never talks to this URL directly — every client-side call goes
# through this Next.js app's own /api/proxy route (see
# src/app/api/proxy/[...path]/route.ts) so the bearer token stays
# server-side in an httpOnly cookie.
API_INTERNAL_BASE_URL=http://api:8000
